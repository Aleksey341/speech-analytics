# Never commit your real key. Optional when using Local/Auto fallback.
OPENAI_API_KEY=sk-your-key-here

# Optional Local engine tuning. Defaults are shown below.
# LIVEINTERPRETER_WHISPER_MODEL=small
# LIVEINTERPRETER_ASR_DEVICE=cpu
# LIVEINTERPRETER_ASR_COMPUTE_TYPE=int8
# LIVEINTERPRETER_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
# LIVEINTERPRETER_TRANSLATION_DEVICE=auto
# LIVEINTERPRETER_PIPER_VOICE_RU=C:\path\to\ru_voice.onnx
# LIVEINTERPRETER_PIPER_VOICE_EN=C:\path\to\en_voice.onnx
